# Copy this file to .env and fill in your own keys.
# Never commit .env — it is listed in .gitignore.

# Alpaca paper trading credentials
# Get them at: https://app.alpaca.markets/paper-trading/overview -> API Keys
ALPACA_API_KEY=your_key_id_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Financial Modeling Prep — optional, used by /auto for fundamental scoring
# Free key at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_key_here

# No other API keys required.
# Congressional trade data comes from Quiver Quantitative (free, no key needed).
# AI reasoning runs through Claude Code (your subscription, no separate key needed).
